{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "title": "muninn chart values",
    "description": "Helm validates these before rendering. Every constrained value below is one a template compares against a literal, where an unrecognized value renders no error and no object - an install that reports success and then does not work.",
    "type": "object",
    "properties": {
        "image": {
            "type": "object",
            "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string" },
                "digest": {
                    "type": "string",
                    "pattern": "^$|^sha256:[a-f0-9]{64}$",
                    "description": "Empty, or a full sha256 digest. A truncated or malformed digest would otherwise render an image reference the kubelet rejects only at pull time."
                }
            },
            "additionalProperties": false
        },
        "webhook": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "failurePolicy": { "enum": ["Fail", "Ignore"] },
                "excludedNamespaces": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            },
            "additionalProperties": false
        },
        "certificate": {
            "type": "object",
            "properties": {
                "mode": {
                    "enum": ["cert-manager", "self-signed", "provided"],
                    "description": "Each template gates on this literal. An unrecognized value renders no certificate and no caBundle while still registering a webhook with failurePolicy: Fail, which blocks Pod creation cluster-wide."
                },
                "secretName": { "type": "string", "minLength": 1 },
                "provided": {
                    "type": "object",
                    "properties": {
                        "caBundle": { "type": "string" }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "secrets": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "spcMode": {
                    "enum": ["Create", "Reference"],
                    "description": "The process compares this case-insensitively while the RBAC template compares it against the literal, so a lower-cased value would grant no write permission to a webhook that then attempts the write."
                },
                "vault": {
                    "type": "object",
                    "properties": {
                        "address": { "type": "string" },
                        "roleName": { "type": "string" }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": true
}
